  "description": "Model Context Protocol server for Digital Canvas: let Claude (or any agent) make posters, social graphics and video reels from your assets.",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "design",
    "canva",
    "claude",
    "video",
    "poster"
  ],
